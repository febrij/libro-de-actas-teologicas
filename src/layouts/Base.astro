---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
const { titulo = 'Libro de actas', descripcion = 'Actas teológicas verificables — una obra de cazador de ídolos', imagen = '/og/portada.png' } = Astro.props;
const imagenAbs = new URL(imagen, Astro.site).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#9c2b23" />
    <link rel="alternate" type="application/rss+xml" title="Libro de actas" href="/rss.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content="Libro de actas" />
    <meta property="og:locale" content="es" />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagenAbs} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ClientRouter />
    <script is:inline>
      // Tema antes del primer pintado — y reaplicado tras cada navegación,
      // porque las transiciones de vista reemplazan los atributos de <html>.
      (function () {
        function aplicar() {
          var t = localStorage.getItem('tema');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'noche' : 'papel';
          if (t !== 'papel') document.documentElement.dataset.tema = t;
          else delete document.documentElement.dataset.tema;
        }
        aplicar();
        document.addEventListener('astro:after-swap', aplicar);
      })();
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&family=Archivo:wght@400;500;600;700&family=Gentium+Plus:ital@0;1&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="progreso" aria-hidden="true"><span></span></div>
    <div class="marco">
      <header class="sitio">
        <a class="marca" href="/">Libro de actas</a>
        <nav>
          <a href="/biblia">Biblia</a>
          <a href="/obra/indice-maestro">Mapa de la obra</a>
          <a href="/indice-pasajes">Índice de pasajes</a>
          <a href="/buscar">Buscar</a>
          <a href="/bereano">Práctica</a>
          <button class="tema-btn" data-tema-btn type="button" title="Modo de lectura" aria-label="Cambiar modo de lectura">◐</button>
        </nav>
      </header>
      <slot />
      <footer class="sitio">
        <a class="pie-marca" href="https://fjcaw.substack.com" rel="me noopener" target="_blank">Una obra de <em>cazador de ídolos</em> ↗</a>
        <span>Soli Deo gloria</span>
      </footer>
    </div>
    <script>
      const ICONO = { papel: '○', sepia: '◐', noche: '●' };
      const ORDEN = ['papel', 'sepia', 'noche'];

      function temaActual() {
        return document.documentElement.dataset.tema || 'papel';
      }
      function aplicarTema(t) {
        if (t === 'papel') delete document.documentElement.dataset.tema;
        else document.documentElement.dataset.tema = t;
        localStorage.setItem('tema', t);
        document.querySelectorAll('[data-tema-btn]').forEach((b) => (b.textContent = ICONO[t]));
      }

      function iniciar() {
        // Botón de tema
        document.querySelectorAll('[data-tema-btn]').forEach((b) => {
          b.textContent = ICONO[temaActual()];
          if (b.dataset.listo) return;
          b.dataset.listo = '1';
          b.addEventListener('click', () => {
            const i = ORDEN.indexOf(temaActual());
            aplicarTema(ORDEN[(i + 1) % ORDEN.length]);
          });
        });

        // Barra de progreso: solo en páginas realmente largas
        const barra = document.querySelector('.progreso');
        const span = barra?.querySelector('span');
        if (barra && span) {
          const largo = () => document.documentElement.scrollHeight - innerHeight;
          barra.classList.toggle('visible', largo() > innerHeight * 1.5);
          let tick = false;
          const pinta = () => {
            span.style.width = Math.min(100, (scrollY / Math.max(1, largo())) * 100) + '%';
            tick = false;
          };
          if (!document.body.dataset.progresoListo) {
            document.body.dataset.progresoListo = '1';
            addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(pinta); } }, { passive: true });
          }
          pinta();
        }

        // Scrollspy del índice + carril abierto en monitores anchos
        const toc = document.querySelector('.toc');
        if (toc) {
          if (matchMedia('(min-width: 1720px)').matches) toc.setAttribute('open', '');
          const enlaces = new Map();
          toc.querySelectorAll('a[href^="#"]').forEach((a) => enlaces.set(decodeURIComponent(a.hash.slice(1)), a));
          const obs = new IntersectionObserver((entradas) => {
            entradas.forEach((e) => {
              if (e.isIntersecting) {
                toc.querySelectorAll('a.activo').forEach((a) => a.classList.remove('activo'));
                enlaces.get(e.target.id)?.classList.add('activo');
              }
            });
          }, { rootMargin: '0px 0px -75% 0px' });
          document.querySelectorAll('article.acta h2[id], article.acta h3[id]').forEach((h) => obs.observe(h));
        }
      }

      // ---------- Voz: glosas y pasajes (síntesis del navegador) ----------
      function hablar(texto, lang, rate) {
        try {
          speechSynthesis.cancel();
          const u = new SpeechSynthesisUtterance(texto);
          u.lang = lang; u.rate = rate;
          const voz = speechSynthesis.getVoices().find((v) => v.lang && v.lang.startsWith(lang.split('-')[0]));
          if (voz) u.voice = voz;
          speechSynthesis.speak(u);
        } catch {}
      }
      try { speechSynthesis.getVoices(); } catch {}
      document.addEventListener('click', (e) => {
        const g = e.target.closest?.('.gloss-audio button');
        if (g) {
          e.preventDefault();
          const gloss = g.closest('.gloss');
          const palabra = gloss?.querySelector('.gloss-word');
          if (palabra) {
            const lang = palabra.getAttribute('lang') === 'he' ? 'he-IL' : 'el-GR';
            hablar(palabra.textContent, lang, g.dataset.vel === 'l' ? 0.45 : 0.85);
          }
          return;
        }
        const pa = e.target.closest?.('.pas-audio');
        if (pa) {
          e.preventDefault();
          const P = pa.closest('.pas-pop');
          if (P?.dataset.audio) hablar(P.dataset.audio, P.dataset.lang || 'es-ES', 0.95);
        }
      });

      // ---------- Popovers de pasajes bíblicos (RVA 1909) ----------
      const cacheBiblia = new Map();
      const VERSIONES = { rva: 'RVA 1909 · dominio público', kjv: 'KJV · dominio público' };
      let versionPas = localStorage.getItem('biblia-version') || 'rva';
      async function libroJson(slug) {
        const clave = versionPas + '/' + slug;
        if (!cacheBiblia.has(clave)) {
          const ruta = versionPas === 'kjv' ? `/biblia/kjv/${slug}.json` : `/biblia/${slug}.json`;
          cacheBiblia.set(clave, fetch(ruta).then((r) => (r.ok ? r.json() : null)).catch(() => null));
        }
        return cacheBiblia.get(clave);
      }

      let pop = null, pasActivo = null, timerPas = null;
      function popEl() {
        if (!pop) {
          pop = document.createElement('div');
          pop.className = 'pas-pop';
          pop.addEventListener('pointerenter', () => clearTimeout(timerPas));
          pop.addEventListener('pointerleave', ocultarPas);
          document.body.appendChild(pop);
        }
        return pop;
      }
      function ocultarPas() {
        timerPas = setTimeout(() => { pop?.classList.remove('visible'); pasActivo = null; }, 180);
      }
      function colocar(el) {
        const r = el.getBoundingClientRect();
        const P = popEl();
        P.style.left = Math.max(8, Math.min(innerWidth - P.offsetWidth - 8, r.left)) + 'px';
        const abajo = r.bottom + 8 + P.offsetHeight < innerHeight;
        P.style.top = (abajo ? r.bottom + 8 : Math.max(8, r.top - P.offsetHeight - 8)) + 'px';
      }
      async function mostrarPas(el) {
        clearTimeout(timerPas);
        pasActivo = el;
        const d = el.dataset;
        const c1 = +d.c1, v1 = +d.v1, c2 = d.c2 ? +d.c2 : c1, v2 = d.v2 ? +d.v2 : v1;
        const etiqueta = `${d.nombre} ${c1}:${v1}` + (d.c2 ? `–${c2}:${v2}` : (v2 !== v1 ? `–${v2}` : ''));
        const P = popEl();
        P.innerHTML = `<h5>${etiqueta}</h5><p class="v">…</p>`;
        P.classList.add('visible');
        colocar(el);
        const libro = await libroJson(d.libro);
        if (pasActivo !== el) return;
        let cuerpo = '', n = 0, cortado = false;
        for (let c = c1; c <= c2 && !cortado; c++) {
          const caps = libro?.capitulos?.[c] || {};
          const desde = c === c1 ? v1 : 1;
          const hasta = c === c2 ? v2 : Math.max(...Object.keys(caps).map(Number), 0);
          for (let v = desde; v <= hasta; v++) {
            if (!caps[v]) continue;
            if (++n > 24) { cortado = true; break; }
            cuerpo += `<p class="v"><sup>${c !== c1 || c2 !== c1 ? c + ':' : ''}${v}</sup>${caps[v]}</p>`;
          }
        }
        if (!cuerpo) cuerpo = '<p class="v">Pasaje no disponible en esta base.</p>';
        if (cortado) cuerpo += '<p class="v">…</p>';
        const bg = `https://www.biblegateway.com/passage/?search=${encodeURIComponent(etiqueta)}&version=RVR1960`;
        const botones = Object.keys(VERSIONES).map((v) =>
          `<button type="button" class="ver-btn${v === versionPas ? ' activa' : ''}" data-ver="${v}">${v === 'rva' ? '1909' : 'KJV'}</button>`).join('');
        P.innerHTML = `<h5>${etiqueta}<span class="ver-btns">${botones}</span></h5>${cuerpo}<footer><span>${VERSIONES[versionPas]}</span><span><button type="button" class="pas-audio" title="Escuchar">🔊</button> <a href="/biblia#${d.libro}/${c1}">Capítulo →</a> <a href="${bg}" target="_blank" rel="noopener">RVR60 ↗</a></span></footer>`;
        P.dataset.audio = Array.from(P.querySelectorAll('.v')).map((x) => x.textContent.replace(/^\d+:?/, '')).join(' ');
        P.dataset.lang = versionPas === 'kjv' ? 'en-US' : 'es-ES';
        P.querySelectorAll('.ver-btn').forEach((b) => b.addEventListener('click', (ev) => {
          ev.stopPropagation();
          versionPas = b.dataset.ver;
          localStorage.setItem('biblia-version', versionPas);
          if (pasActivo) mostrarPas(pasActivo);
        }));
        colocar(el);
      }
      document.addEventListener('pointerover', (e) => {
        const el = e.target.closest?.('.pas');
        if (el && el !== pasActivo) mostrarPas(el);
        else if (el) clearTimeout(timerPas);
      });
      document.addEventListener('pointerout', (e) => {
        if (e.target.closest?.('.pas')) ocultarPas();
      });
      document.addEventListener('click', (e) => {
        const el = e.target.closest?.('.pas');
        if (el) { e.preventDefault(); pasActivo === el && pop?.classList.contains('visible') ? (pop.classList.remove('visible'), pasActivo = null) : mostrarPas(el); }
        else if (!e.target.closest?.('.pas-pop')) pop?.classList.remove('visible');
      });
      addEventListener('scroll', () => { if (pop?.classList.contains('visible') && pasActivo) colocar(pasActivo); }, { passive: true });

      // ---------- Observaciones al margen: seleccionar texto -> observar ----------
      let obsBtn = null, obsDlg = null, obsDatos = null;
      function btnObs() {
        if (!obsBtn) {
          obsBtn = document.createElement('button');
          obsBtn.className = 'obs-btn'; obsBtn.type = 'button'; obsBtn.textContent = '✎ Observar';
          obsBtn.addEventListener('mousedown', (e) => e.preventDefault());
          obsBtn.addEventListener('click', abrirObs);
          document.body.appendChild(obsBtn);
        }
        return obsBtn;
      }
      function seccionDe(nodo) {
        let el = nodo.nodeType === 1 ? nodo : nodo.parentElement;
        while (el && !el.matches?.('article.acta')) {
          let prev = el.previousElementSibling;
          while (prev) {
            if (/^H[23]$/.test(prev.tagName) && prev.id) return prev.id;
            prev = prev.previousElementSibling;
          }
          el = el.parentElement;
        }
        return '';
      }
      document.addEventListener('selectionchange', () => {
        const sel = getSelection();
        const dentro = sel && !sel.isCollapsed && sel.anchorNode &&
          (sel.anchorNode.nodeType === 1 ? sel.anchorNode : sel.anchorNode.parentElement)?.closest?.('article.acta');
        if (dentro && sel.toString().trim().length > 3) {
          const r = sel.getRangeAt(0).getBoundingClientRect();
          const b = btnObs();
          b.style.display = 'block';
          b.style.left = Math.max(8, Math.min(innerWidth - 120, r.left + r.width / 2 - 50)) + 'px';
          b.style.top = Math.max(8, r.top - 42) + 'px';
          obsDatos = {
            cita: sel.toString().slice(0, 1200),
            seccion: seccionDe(sel.anchorNode),
            acta: location.pathname,
            url: location.origin + location.pathname + (seccionDe(sel.anchorNode) ? '#' + seccionDe(sel.anchorNode) : ''),
          };
        } else if (obsBtn) obsBtn.style.display = 'none';
      });
      function abrirObs() {
        obsBtn.style.display = 'none';
        if (!obsDlg) {
          obsDlg = document.createElement('div');
          obsDlg.className = 'obs-dlg';
          obsDlg.innerHTML = `
            <h5>Observación al margen <button type="button" class="obs-x" aria-label="Cerrar">×</button></h5>
            <blockquote class="obs-cita"></blockquote>
            <textarea class="obs-texto" rows="4" maxlength="4000" placeholder="Tu observación sobre el fragmento señalado. Se publica al pie del acta después de moderación."></textarea>
            <input class="obs-nombre" type="text" maxlength="120" placeholder="Nombre (opcional)">
            <input class="obs-contacto" type="text" maxlength="200" placeholder="Correo o contacto (opcional, por si hay que responderte)">
            <input class="obs-web" type="text" tabindex="-1" autocomplete="off" aria-hidden="true">
            <div class="obs-pieb"><span class="obs-aviso"></span><button type="button" class="obs-enviar ber-btn ber-sig">Enviar</button></div>`;
          document.body.appendChild(obsDlg);
          obsDlg.querySelector('.obs-x').addEventListener('click', () => obsDlg.classList.remove('visible'));
          obsDlg.querySelector('.obs-enviar').addEventListener('click', enviarObs);
        }
        const bq = obsDlg.querySelector('.obs-cita');
        bq.style.display = obsDatos.cita ? '' : 'none';
        bq.textContent = obsDatos.cita ? '“' + obsDatos.cita.slice(0, 220) + (obsDatos.cita.length > 220 ? '…' : '') + '”' : '';
        obsDlg.querySelector('.obs-aviso').textContent = '';
        obsDlg.classList.add('visible');
        obsDlg.querySelector('.obs-texto').focus();
      }
      async function enviarObs() {
        const aviso = obsDlg.querySelector('.obs-aviso');
        const cuerpo = {
          ...obsDatos,
          comentario: obsDlg.querySelector('.obs-texto').value.trim(),
          nombre: obsDlg.querySelector('.obs-nombre').value.trim(),
          contacto: obsDlg.querySelector('.obs-contacto').value.trim(),
          web: obsDlg.querySelector('.obs-web').value,
        };
        if (cuerpo.comentario.length < 5) { aviso.textContent = 'Escribe la observación primero.'; return; }
        aviso.textContent = 'Enviando…';
        try {
          const r = await fetch('/api/observacion', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cuerpo) });
          if (!r.ok) throw 0;
          aviso.textContent = '';
          obsDlg.querySelector('.obs-texto').value = '';
          obsDlg.classList.remove('visible');
          const ok = document.createElement('div');
          ok.className = 'obs-ok'; ok.textContent = 'Recibida — se publicará al pie del acta tras moderación. Gracias, bereano.';
          document.body.appendChild(ok);
          setTimeout(() => ok.remove(), 3500);
        } catch { aviso.textContent = 'No se pudo enviar. Intenta de nuevo.'; }
      }

      window.abrirObsGeneral = (acta) => {
        obsDatos = { cita: '', seccion: '', acta, url: location.origin + acta };
        abrirObs();
      };

      document.addEventListener('astro:page-load', iniciar);
    </script>
  </body>
</html>
