---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
const { titulo = 'Libro de actas', descripcion = 'Actas teológicas verificables — una obra de cazador de ídolos', imagen = '/og/portada.png' } = Astro.props;
const imagenAbs = new URL(imagen, Astro.site).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#9c2b23" />
    <link rel="alternate" type="application/rss+xml" title="Libro de actas" href="/rss.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content="Libro de actas" />
    <meta property="og:locale" content="es" />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagenAbs} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ClientRouter />
    <script is:inline>
      // Tema antes del primer pintado, sin parpadeo
      (function () {
        var t = localStorage.getItem('tema');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'noche' : 'papel';
        if (t !== 'papel') document.documentElement.dataset.tema = t;
      })();
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&family=Archivo:wght@400;500;600;700&family=Gentium+Plus:ital@0;1&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="progreso" aria-hidden="true"><span></span></div>
    <div class="marco">
      <header class="sitio">
        <a class="marca" href="/">Libro de actas</a>
        <nav>
          <a href="/obra/indice-maestro">Mapa de la obra</a>
          <a href="/indice-pasajes">Índice de pasajes</a>
          <a href="/buscar">Buscar</a>
          <button class="tema-btn" data-tema-btn type="button" title="Modo de lectura" aria-label="Cambiar modo de lectura">◐</button>
        </nav>
      </header>
      <slot />
      <footer class="sitio">
        <a class="pie-marca" href="https://fjcaw.substack.com" rel="me noopener" target="_blank">Una obra de <em>cazador de ídolos</em> ↗</a>
        <span>Soli Deo gloria</span>
      </footer>
    </div>
    <script>
      const ICONO = { papel: '○', sepia: '◐', noche: '●' };
      const ORDEN = ['papel', 'sepia', 'noche'];

      function temaActual() {
        return document.documentElement.dataset.tema || 'papel';
      }
      function aplicarTema(t) {
        if (t === 'papel') delete document.documentElement.dataset.tema;
        else document.documentElement.dataset.tema = t;
        localStorage.setItem('tema', t);
        document.querySelectorAll('[data-tema-btn]').forEach((b) => (b.textContent = ICONO[t]));
      }

      function iniciar() {
        // Botón de tema
        document.querySelectorAll('[data-tema-btn]').forEach((b) => {
          b.textContent = ICONO[temaActual()];
          if (b.dataset.listo) return;
          b.dataset.listo = '1';
          b.addEventListener('click', () => {
            const i = ORDEN.indexOf(temaActual());
            aplicarTema(ORDEN[(i + 1) % ORDEN.length]);
          });
        });

        // Barra de progreso: solo en páginas realmente largas
        const barra = document.querySelector('.progreso');
        const span = barra?.querySelector('span');
        if (barra && span) {
          const largo = () => document.documentElement.scrollHeight - innerHeight;
          barra.classList.toggle('visible', largo() > innerHeight * 1.5);
          let tick = false;
          const pinta = () => {
            span.style.width = Math.min(100, (scrollY / Math.max(1, largo())) * 100) + '%';
            tick = false;
          };
          if (!document.body.dataset.progresoListo) {
            document.body.dataset.progresoListo = '1';
            addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(pinta); } }, { passive: true });
          }
          pinta();
        }

        // Scrollspy del índice + carril abierto en monitores anchos
        const toc = document.querySelector('.toc');
        if (toc) {
          if (matchMedia('(min-width: 1720px)').matches) toc.setAttribute('open', '');
          const enlaces = new Map();
          toc.querySelectorAll('a[href^="#"]').forEach((a) => enlaces.set(decodeURIComponent(a.hash.slice(1)), a));
          const obs = new IntersectionObserver((entradas) => {
            entradas.forEach((e) => {
              if (e.isIntersecting) {
                toc.querySelectorAll('a.activo').forEach((a) => a.classList.remove('activo'));
                enlaces.get(e.target.id)?.classList.add('activo');
              }
            });
          }, { rootMargin: '0px 0px -75% 0px' });
          document.querySelectorAll('article.acta h2[id], article.acta h3[id]').forEach((h) => obs.observe(h));
        }
      }

      // ---------- Popovers de pasajes bíblicos (RVA 1909) ----------
      const cacheBiblia = new Map();
      const VERSIONES = { rva: 'RVA 1909 · dominio público', kjv: 'KJV · dominio público' };
      let versionPas = localStorage.getItem('biblia-version') || 'rva';
      async function libroJson(slug) {
        const clave = versionPas + '/' + slug;
        if (!cacheBiblia.has(clave)) {
          const ruta = versionPas === 'kjv' ? `/biblia/kjv/${slug}.json` : `/biblia/${slug}.json`;
          cacheBiblia.set(clave, fetch(ruta).then((r) => (r.ok ? r.json() : null)).catch(() => null));
        }
        return cacheBiblia.get(clave);
      }

      let pop = null, pasActivo = null, timerPas = null;
      function popEl() {
        if (!pop) {
          pop = document.createElement('div');
          pop.className = 'pas-pop';
          pop.addEventListener('pointerenter', () => clearTimeout(timerPas));
          pop.addEventListener('pointerleave', ocultarPas);
          document.body.appendChild(pop);
        }
        return pop;
      }
      function ocultarPas() {
        timerPas = setTimeout(() => { pop?.classList.remove('visible'); pasActivo = null; }, 180);
      }
      function colocar(el) {
        const r = el.getBoundingClientRect();
        const P = popEl();
        P.style.left = Math.max(8, Math.min(innerWidth - P.offsetWidth - 8, r.left)) + 'px';
        const abajo = r.bottom + 8 + P.offsetHeight < innerHeight;
        P.style.top = (abajo ? r.bottom + 8 : Math.max(8, r.top - P.offsetHeight - 8)) + 'px';
      }
      async function mostrarPas(el) {
        clearTimeout(timerPas);
        pasActivo = el;
        const d = el.dataset;
        const c1 = +d.c1, v1 = +d.v1, c2 = d.c2 ? +d.c2 : c1, v2 = d.v2 ? +d.v2 : v1;
        const etiqueta = `${d.nombre} ${c1}:${v1}` + (d.c2 ? `–${c2}:${v2}` : (v2 !== v1 ? `–${v2}` : ''));
        const P = popEl();
        P.innerHTML = `<h5>${etiqueta}</h5><p class="v">…</p>`;
        P.classList.add('visible');
        colocar(el);
        const libro = await libroJson(d.libro);
        if (pasActivo !== el) return;
        let cuerpo = '', n = 0, cortado = false;
        for (let c = c1; c <= c2 && !cortado; c++) {
          const caps = libro?.capitulos?.[c] || {};
          const desde = c === c1 ? v1 : 1;
          const hasta = c === c2 ? v2 : Math.max(...Object.keys(caps).map(Number), 0);
          for (let v = desde; v <= hasta; v++) {
            if (!caps[v]) continue;
            if (++n > 24) { cortado = true; break; }
            cuerpo += `<p class="v"><sup>${c !== c1 || c2 !== c1 ? c + ':' : ''}${v}</sup>${caps[v]}</p>`;
          }
        }
        if (!cuerpo) cuerpo = '<p class="v">Pasaje no disponible en esta base.</p>';
        if (cortado) cuerpo += '<p class="v">…</p>';
        const bg = `https://www.biblegateway.com/passage/?search=${encodeURIComponent(etiqueta)}&version=RVR1960`;
        const botones = Object.keys(VERSIONES).map((v) =>
          `<button type="button" class="ver-btn${v === versionPas ? ' activa' : ''}" data-ver="${v}">${v === 'rva' ? '1909' : 'KJV'}</button>`).join('');
        P.innerHTML = `<h5>${etiqueta}<span class="ver-btns">${botones}</span></h5>${cuerpo}<footer><span>${VERSIONES[versionPas]}</span><a href="${bg}" target="_blank" rel="noopener">Cotejar en RVR60 ↗</a></footer>`;
        P.querySelectorAll('.ver-btn').forEach((b) => b.addEventListener('click', (ev) => {
          ev.stopPropagation();
          versionPas = b.dataset.ver;
          localStorage.setItem('biblia-version', versionPas);
          if (pasActivo) mostrarPas(pasActivo);
        }));
        colocar(el);
      }
      document.addEventListener('pointerover', (e) => {
        const el = e.target.closest?.('.pas');
        if (el && el !== pasActivo) mostrarPas(el);
        else if (el) clearTimeout(timerPas);
      });
      document.addEventListener('pointerout', (e) => {
        if (e.target.closest?.('.pas')) ocultarPas();
      });
      document.addEventListener('click', (e) => {
        const el = e.target.closest?.('.pas');
        if (el) { e.preventDefault(); pasActivo === el && pop?.classList.contains('visible') ? (pop.classList.remove('visible'), pasActivo = null) : mostrarPas(el); }
        else if (!e.target.closest?.('.pas-pop')) pop?.classList.remove('visible');
      });
      addEventListener('scroll', () => { if (pop?.classList.contains('visible') && pasActivo) colocar(pasActivo); }, { passive: true });

      document.addEventListener('astro:page-load', iniciar);
    </script>
  </body>
</html>
