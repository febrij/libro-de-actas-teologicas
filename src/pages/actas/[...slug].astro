---
import Base from '../../layouts/Base.astro';
import Nota from '../../components/Nota.astro';
import Gloss from '../../components/Gloss.astro';
import Careo from '../../components/Careo.astro';
import Conf from '../../components/Conf.astro';
import Epigrafe from '../../components/Epigrafe.astro';
import Plegable from '../../components/Plegable.astro';
import { getCollection, render } from 'astro:content';
import { romano, fechaLarga, SERIES } from '../../lib/util';

export async function getStaticPaths() {
  const actas = await getCollection('actas', ({ data }) => !data.borrador);
  return actas.map((acta) => ({ params: { slug: acta.id }, props: { acta } }));
}

const { acta } = Astro.props;
const { Content, headings } = await render(acta);
const d = acta.data;

// Acta anterior y siguiente, por orden dentro de la misma serie
const todas = (await getCollection('actas', ({ data }) => !data.borrador))
  .filter((a) => a.data.serie === d.serie)
  .sort((a, b) => a.data.orden - b.data.orden);
const i = todas.findIndex((a) => a.id === acta.id);
const anterior = i > 0 ? todas[i - 1] : null;
const siguiente = i < todas.length - 1 ? todas[i + 1] : null;

// Backlinks: qué actas y documentos citan a esta por su título
const todasLasActas = await getCollection('actas', ({ data }) => !data.borrador);
const documentos = await getCollection('documentos');
const citadaEn = [
  ...todasLasActas.filter((a) => a.id !== acta.id && (a.body ?? '').includes(d.titulo))
    .map((a) => ({ url: `/actas/${a.id}`, etiqueta: `${romano(a.data.orden)} · ${a.data.titulo}` })),
  ...documentos.filter((doc) => (doc.body ?? '').includes(d.titulo))
    .map((doc) => ({ url: `/obra/${doc.id}`, etiqueta: doc.data.titulo })),
];

// Tiempo de lectura (~210 palabras/min en español)
const palabras = (acta.body ?? '').split(/\s+/).length;
const minutos = Math.max(1, Math.round(palabras / 210));

// Índice: solo encabezados de nivel 2 y 3
const indice = headings.filter((h) => h.depth === 2 || h.depth === 3);

// "Read in English" vía Google Translate (sin widget incrustado)
const urlActa = new URL(Astro.url.pathname, Astro.site).href;
const urlEn = `https://translate.google.com/translate?sl=es&tl=en&u=${encodeURIComponent(urlActa)}`;
---
<Base titulo={`Acta ${romano(d.orden)} · ${d.titulo}`} descripcion={d.resumen} imagen={`/og/${acta.id}.png`}>
  <div class="acta-cabecera">
    <p class="eyebrow">{SERIES[d.serie].nombre}</p>
    <div class="numeral" transition:name={`num-${d.serie}-${d.orden}`}><small>Acta</small>{romano(d.orden)}</div>
    <h1>{d.titulo}</h1>
    {d.subtitulo && <p class="sub">{d.subtitulo}</p>}
    <div class="acta-meta">
      <span>Locus · <b>{d.loci}</b></span>
      <span>Levantada el <b>{fechaLarga(d.fecha)}</b></span>
      <span>Lectura · <b>{minutos} min</b></span>
      {d.estado && <span>Estado · <b>{d.estado}</b></span>}
      {d.pasajes.length > 0 && <span>Pasajes citados · <b>{d.pasajes.length}</b></span>}
      <span><a href={urlEn} rel="nofollow noopener">Read in English ↗</a></span>
    </div>
  </div>

  {indice.length > 2 && (
    <details class="toc">
      <summary>Índice del acta</summary>
      <ol>
        {indice.map((h) => (
          <li class={`toc-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </details>
  )}

  <article class="acta" data-pagefind-body>
    <Content components={{ Nota, Gloss, Careo, Conf, Epigrafe, Plegable }} />
  </article>

  {citadaEn.length > 0 && (
    <nav class="citada">
      <span class="citada-rotulo">Citada en</span>
      {citadaEn.map((c) => <a href={c.url}>{c.etiqueta}</a>)}
    </nav>
  )}

  {(anterior || siguiente) && (
    <nav class="acta-nav">
      {anterior && (
        <a href={`/actas/${anterior.id}`}>
          <span class="dir">← Acta {romano(anterior.data.orden)}</span>
          <span class="cual">{anterior.data.titulo}</span>
        </a>
      )}
      {siguiente && (
        <a class="sig" href={`/actas/${siguiente.id}`}>
          <span class="dir">Acta {romano(siguiente.data.orden)} →</span>
          <span class="cual">{siguiente.data.titulo}</span>
        </a>
      )}
    </nav>
  )}

  <script>
    function prepararActa() {
    // Tablas: cada celda recuerda su encabezado, para el modo ficha en movil
    document.querySelectorAll('article.acta table').forEach((t) => {
      const ths = [...t.querySelectorAll('thead th')].map((th) => th.textContent.trim());
      if (!ths.length) return;
      t.querySelectorAll('tbody tr').forEach((tr) => {
        [...tr.children].forEach((td, i) => {
          if (i > 0 && ths[i]) td.setAttribute('data-label', ths[i]);
        });
      });
    });

    // Ancla § en cada sección: clic copia el enlace directo al parágrafo
    document.querySelectorAll('article.acta h2[id], article.acta h3[id]').forEach((h) => {
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.className = 'ancla';
      a.textContent = '§';
      a.title = 'Enlace a esta sección';
      a.addEventListener('click', () => {
        navigator.clipboard?.writeText(location.origin + location.pathname + '#' + h.id);
      });
      if (!h.querySelector('.ancla')) h.appendChild(a);
    });
    }
    document.addEventListener('astro:page-load', prepararActa);
  </script>
</Base>
