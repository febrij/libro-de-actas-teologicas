---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { romano, SERIES, CANON } from '../lib/util';
import mapa from '../lib/biblia-mapa.json';

const actas = await getCollection('actas', ({ data }) => !data.borrador);
const porNombre = new Map(mapa.map((l) => [l.nombre, l.slug]));

// Pool 1: pasajes declarados (con versículo)
const pasajes = [];
for (const acta of actas) {
  for (const cita of acta.data.pasajes) {
    const m = cita.match(/^(.+?)\s+(\d{1,3}):(\d{1,3})(?:\s?[-–]\s?(?:(\d{1,3}):)?(\d{1,3}))?$/);
    if (!m) continue;
    const slug = porNombre.get(m[1]);
    if (!slug) continue;
    pasajes.push({
      cita, libro: slug,
      c1: +m[2], v1: +m[3], c2: m[4] ? +m[4] : +m[2], v2: m[5] ? +m[5] : +m[3],
      acta: `${SERIES[acta.data.serie].corto} · ${romano(acta.data.orden)}`,
      url: `/actas/${acta.id}`,
    });
  }
}
pasajes.sort((a, b) => CANON.indexOf(a.cita.split(/\s+\d/)[0]) - CANON.indexOf(b.cita.split(/\s+\d/)[0]));

// Pool 2: conclusiones de los tableros de confianza
const tablero = [];
for (const acta of actas) {
  const cuerpo = acta.body ?? '';
  const m = cuerpo.match(/^#{2,3} .*[Tt]ablero de confianza.*$([\s\S]*?)(?=^#{1,3} |(?![\s\S]))/m);
  if (!m) continue;
  const filas = m[1].split('\n').filter((l) => l.trim().startsWith('|') && !l.includes('---')).slice(1);
  for (const l of filas) {
    const celdas = l.trim().replace(/^\||\|$/g, '').split('|').map((c) => c.replace(/\*/g, '').trim());
    if (celdas.length >= 2 && celdas[0]) {
      tablero.push({
        conclusion: celdas[0], nivel: celdas[1] || '—', nota: celdas.slice(2).join(' · '),
        acta: `${SERIES[acta.data.serie].corto} · ${romano(acta.data.orden)}`,
        url: `/actas/${acta.id}`,
      });
    }
  }
}
---
<Base titulo="Práctica bereana · Libro de actas" descripcion="Ejercitador de los pasajes y conclusiones que sostienen las actas.">
  <p class="eyebrow"><b>Aparato</b> · escudriñando cada día las Escrituras</p>
  <h1 class="portada-titulo">Práctica bereana</h1>
  <p class="portada-lema">{pasajes.length} pasajes y {tablero.length} conclusiones de los tableros, como ejercicio. Lo que marques <em>repasar</em> vuelve más seguido; lo que ya sabes, se espacia. Sin puntos ni trofeos — solo el texto y tú.</p>

  <div class="ber-modos" role="group" aria-label="Modo de práctica">
    <button type="button" data-modo="ref" aria-pressed="true">Referencia → texto</button>
    <button type="button" data-modo="inv" aria-pressed="false">Texto → referencia</button>
    <button type="button" data-modo="tab" aria-pressed="false">Tablero</button>
  </div>

  <div class="ber-carta" id="ber">
    <p class="ber-donde" id="ber-donde"></p>
    <p class="ber-ref" id="ber-grande">—</p>
    <div class="ber-texto" id="ber-cuerpo" hidden></div>
    <div class="ber-acciones" id="ber-acciones"></div>
    <p class="ber-pie"><span id="ber-conteo"></span> · <a id="ber-enlace" href="/">ir a la acta</a> · <a href="/indice-pasajes">índice</a></p>
  </div>

  <script is:inline data-astro-rerun define:vars={{ pasajes, tablero }}>
    (function () {
      const carta = document.getElementById('ber');
      if (!carta || carta.dataset.listo) return;
      carta.dataset.listo = '1';
      const $ = (id) => document.getElementById(id);

      // ---------- pesos de repetición ----------
      const pesos = JSON.parse(localStorage.getItem('ber-pesos') || '{}');
      const peso = (k) => pesos[k] || 1;
      function ajustar(k, delta) {
        pesos[k] = Math.min(6, Math.max(1, peso(k) + delta));
        localStorage.setItem('ber-pesos', JSON.stringify(pesos));
      }
      function elegirDe(pool, clave) {
        const total = pool.reduce((s, x) => s + peso(clave(x)), 0);
        let r = Math.random() * total;
        for (const x of pool) { r -= peso(clave(x)); if (r <= 0) return x; }
        return pool[pool.length - 1];
      }

      // ---------- corpus ----------
      const cache = new Map();
      const version = () => localStorage.getItem('biblia-version') || 'rva';
      async function versos(p) {
        const clave = version() + '/' + p.libro;
        if (!cache.has(clave)) {
          const ruta = version() === 'kjv' ? `/biblia/kjv/${p.libro}.json` : `/biblia/${p.libro}.json`;
          cache.set(clave, fetch(ruta).then((r) => r.json()).catch(() => null));
        }
        const l = await cache.get(clave);
        const out = [];
        for (let c = p.c1; c <= p.c2; c++) {
          const caps = (l && l.capitulos[c]) || {};
          const desde = c === p.c1 ? p.v1 : 1;
          const hasta = c === p.c2 ? p.v2 : Math.max(...Object.keys(caps).map(Number), 0);
          for (let v = desde; v <= hasta; v++) if (caps[v]) out.push({ c, v, t: caps[v] });
        }
        return out;
      }
      const nivelClase = (n) => { n = n.toLowerCase(); return n.includes('alta') ? 'alta' : n.includes('media') ? 'media' : 'abierto'; };
      const ocultar = (t) => {
        const ps = t.split(/\s+/);
        const idx = ps.map((p, i) => [p.replace(/[^\wÁ-ÿ]/g, '').length, i]).sort((a, b) => b[0] - a[0])
          .slice(0, Math.max(2, Math.floor(ps.length / 8))).map((x) => x[1]);
        return ps.map((p, i) => idx.includes(i) ? p.replace(/[\wÁ-ÿ]/g, '_') : p).join(' ');
      };

      // ---------- estado ----------
      let modo = localStorage.getItem('ber-modo') || 'ref';
      let actual = null;
      function contar() {
        const n = parseInt(localStorage.getItem('ber-practicados') || '0', 10) + 1;
        localStorage.setItem('ber-practicados', String(n));
        pintaConteo();
      }
      function pintaConteo() { $('ber-conteo').textContent = 'Practicados: ' + (localStorage.getItem('ber-practicados') || 0); }

      function botones(lista) {
        $('ber-acciones').innerHTML = '';
        for (const [texto, fn, clase] of lista) {
          const b = document.createElement('button');
          b.type = 'button'; b.className = 'ber-btn' + (clase ? ' ' + clase : ''); b.textContent = texto;
          b.addEventListener('click', fn);
          $('ber-acciones').appendChild(b);
        }
      }
      function pesoBotones(k) {
        return [
          ['La sé', () => { ajustar(k, -1); siguiente(); }],
          ['Repasar pronto', () => { ajustar(k, +2); siguiente(); }],
          ['Otro →', siguiente, 'ber-sig'],
        ];
      }

      // ---------- modos ----------
      function siguiente() {
        $('ber-cuerpo').hidden = true; $('ber-cuerpo').innerHTML = '';
        if (modo === 'tab') {
          actual = elegirDe(tablero, (x) => 'T:' + x.conclusion);
          $('ber-donde').textContent = 'Conclusión del tablero · ' + actual.acta;
          $('ber-grande').textContent = actual.conclusion;
          $('ber-grande').classList.add('ber-tesis');
          $('ber-enlace').href = actual.url;
          botones([[ 'Revelar nivel y textos', revelarTab, 'ber-sig' ]]);
        } else {
          actual = elegirDe(pasajes, (x) => x.cita);
          $('ber-grande').classList.remove('ber-tesis');
          $('ber-enlace').href = actual.url;
          if (modo === 'ref') {
            $('ber-donde').textContent = 'Citado en ' + actual.acta;
            $('ber-grande').textContent = actual.cita;
            botones([[ 'Revelar el texto', () => revelarRef(false) ], [ 'Con huecos', () => revelarRef(true) ], [ 'Otro →', siguiente, 'ber-sig' ]]);
          } else {
            $('ber-donde').textContent = '¿Dónde está escrito? · ' + actual.acta;
            $('ber-grande').textContent = '…';
            versos(actual).then((vs) => {
              $('ber-cuerpo').innerHTML = '<p class="v ber-inv">' + vs.map((x) => x.t).join(' ') + '</p>';
              $('ber-cuerpo').hidden = false;
            });
            botones([[ 'Revelar la referencia', revelarInv, 'ber-sig' ]]);
          }
        }
      }

      async function revelarRef(conHuecos) {
        const vs = await versos(actual);
        let html = vs.map((x) => `<p class="v"><sup>${actual.c2 !== actual.c1 ? x.c + ':' : ''}${x.v}</sup>${conHuecos ? ocultar(x.t) : x.t}</p>`).join('');
        $('ber-cuerpo').innerHTML = html;
        $('ber-cuerpo').hidden = false;
        if (conHuecos) botones([[ 'Ver completo', () => revelarRef(false), 'ber-sig' ]]);
        else { contar(); botones(pesoBotones(actual.cita)); }
      }
      function revelarInv() {
        $('ber-grande').textContent = actual.cita;
        contar();
        botones(pesoBotones(actual.cita));
      }
      function revelarTab() {
        const cl = nivelClase(actual.nivel);
        $('ber-cuerpo').innerHTML =
          `<p class="v"><span class="conf conf-${cl}">${actual.nivel}</span></p>` +
          (actual.nota ? `<p class="v">${actual.nota}</p>` : '');
        $('ber-cuerpo').hidden = false;
        contar();
        botones(pesoBotones('T:' + actual.conclusion));
      }

      // ---------- selector de modo ----------
      document.querySelectorAll('.ber-modos button').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.modo === modo));
        b.addEventListener('click', () => {
          modo = b.dataset.modo;
          localStorage.setItem('ber-modo', modo);
          document.querySelectorAll('.ber-modos button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          siguiente();
        });
      });

      pintaConteo();
      siguiente();
    })();
  </script>
</Base>
