---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { romano, SERIES, CANON } from '../lib/util';
import mapa from '../lib/biblia-mapa.json';

// Todos los pasajes declarados en las actas publicadas, con su libro resuelto
const actas = await getCollection('actas', ({ data }) => !data.borrador);
const porNombre = new Map(mapa.map((l) => [l.nombre, l.slug]));

const pasajes = [];
for (const acta of actas) {
  for (const cita of acta.data.pasajes) {
    const m = cita.match(/^(.+?)\s+(\d{1,3}):(\d{1,3})(?:\s?[-–]\s?(?:(\d{1,3}):)?(\d{1,3}))?$/);
    if (!m) continue; // referencias de capítulo entero quedan fuera de la práctica
    const slug = porNombre.get(m[1]);
    if (!slug) continue;
    pasajes.push({
      cita,
      libro: slug,
      nombre: m[1],
      c1: +m[2], v1: +m[3],
      c2: m[4] ? +m[4] : +m[2],
      v2: m[5] ? +m[5] : +m[3],
      acta: `${SERIES[acta.data.serie].corto} · ${romano(acta.data.orden)}`,
      url: `/actas/${acta.id}`,
    });
  }
}
// Orden canónico para el listado; la práctica los baraja en el cliente
pasajes.sort((a, b) => CANON.indexOf(a.nombre.replace(/^Salmos$/, 'Salmo')) - CANON.indexOf(b.nombre.replace(/^Salmos$/, 'Salmo')));
---
<Base titulo="Práctica bereana · Libro de actas" descripcion="Ejercitador de los pasajes que sostienen las actas: referencia, memoria, texto.">
  <p class="eyebrow"><b>Aparato</b> · escudriñando cada día las Escrituras</p>
  <h1 class="portada-titulo">Práctica bereana</h1>
  <p class="portada-lema">Los {pasajes.length} pasajes que sostienen las actas, como ejercicio: se te da la referencia; recita o recuerda; revela y coteja. Sin puntos ni trofeos — solo el texto y tú.</p>

  <div class="ber-carta" id="ber">
    <p class="ber-donde"><span id="ber-acta"></span></p>
    <p class="ber-ref" id="ber-ref">—</p>
    <div class="ber-texto" id="ber-texto" hidden></div>
    <div class="ber-acciones">
      <button type="button" class="ber-btn" id="ber-revelar">Revelar el texto</button>
      <button type="button" class="ber-btn" id="ber-oculto">Con huecos</button>
      <button type="button" class="ber-btn ber-sig" id="ber-otro">Otro pasaje →</button>
    </div>
    <p class="ber-pie"><span id="ber-conteo"></span> · <a id="ber-enlace" href="/">ir a la acta</a> · <a href="/indice-pasajes">índice completo</a></p>
  </div>

  <script is:inline data-astro-rerun define:vars={{ pasajes }}>
    (function () {
      const carta = document.getElementById('ber');
      if (!carta || carta.dataset.listo) return;
      carta.dataset.listo = '1';

      const $ = (id) => document.getElementById(id);
      let actual = null, modoOculto = false;
      const cache = new Map();
      const version = () => localStorage.getItem('biblia-version') || 'rva';

      async function libro(slug) {
        const clave = version() + '/' + slug;
        if (!cache.has(clave)) {
          const ruta = version() === 'kjv' ? `/biblia/kjv/${slug}.json` : `/biblia/${slug}.json`;
          cache.set(clave, fetch(ruta).then((r) => r.json()).catch(() => null));
        }
        return cache.get(clave);
      }

      function elegir() {
        actual = pasajes[Math.floor(Math.random() * pasajes.length)];
        $('ber-ref').textContent = actual.cita;
        $('ber-acta').textContent = 'Citado en ' + actual.acta;
        $('ber-enlace').href = actual.url;
        $('ber-texto').hidden = true;
        $('ber-texto').innerHTML = '';
      }

      function ocultarPalabras(t) {
        const palabras = t.split(/\s+/);
        const indices = palabras.map((p, i) => [p.replace(/[^\wÁ-ÿ]/g, '').length, i])
          .sort((a, b) => b[0] - a[0]).slice(0, Math.max(2, Math.floor(palabras.length / 8))).map((x) => x[1]);
        return palabras.map((p, i) => indices.includes(i) ? p.replace(/[\wÁ-ÿ]/g, '_') : p).join(' ');
      }

      async function revelar(conHuecos) {
        modoOculto = conHuecos;
        const l = await libro(actual.libro);
        let html = '';
        for (let c = actual.c1; c <= actual.c2; c++) {
          const caps = (l && l.capitulos[c]) || {};
          const desde = c === actual.c1 ? actual.v1 : 1;
          const hasta = c === actual.c2 ? actual.v2 : Math.max(...Object.keys(caps).map(Number), 0);
          for (let v = desde; v <= hasta; v++) {
            if (!caps[v]) continue;
            const texto = conHuecos ? ocultarPalabras(caps[v]) : caps[v];
            html += `<p class="v"><sup>${actual.c2 !== actual.c1 ? c + ':' : ''}${v}</sup>${texto}</p>`;
          }
        }
        $('ber-texto').innerHTML = html + (conHuecos ? '<button type="button" class="ber-btn" id="ber-completo">Ver completo</button>' : '');
        $('ber-texto').hidden = false;
        document.getElementById('ber-completo')?.addEventListener('click', () => revelar(false));
        if (!conHuecos) contar();
      }

      function contar() {
        const n = (parseInt(localStorage.getItem('ber-practicados') || '0', 10) + 1);
        localStorage.setItem('ber-practicados', String(n));
        pinta(n);
      }
      function pinta(n) {
        $('ber-conteo').textContent = `Practicados: ${n ?? (localStorage.getItem('ber-practicados') || 0)}`;
      }

      $('ber-revelar').addEventListener('click', () => revelar(false));
      $('ber-oculto').addEventListener('click', () => revelar(true));
      $('ber-otro').addEventListener('click', elegir);
      pinta();
      elegir();
    })();
  </script>
</Base>
