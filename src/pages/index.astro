---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { romano, fechaLarga } from '../lib/util';

const actas = (await getCollection('actas', ({ data }) => !data.borrador))
  .sort((a, b) => a.data.orden - b.data.orden);
---
<Base>
  <p class="eyebrow"><b>Serie teológica</b> · sistemática en orden canónico</p>
  <h1 class="portada-titulo">Un pueblo, un pacto, una venida</h1>
  <p class="portada-lema">Actas de un examen de los loci teológicos, de la Bibliología a la Escatología, con las fuentes a la vista.</p>

  <ol class="registro">
    {actas.map((acta) => (
      <li>
        <a href={`/actas/${acta.id}`}>
          <span class="num">{romano(acta.data.orden)}</span>
          <span>
            <span class="meta">{acta.data.loci} · {fechaLarga(acta.data.fecha)}</span>
            <h3>{acta.data.titulo}</h3>
            <p>{acta.data.resumen}</p>
          </span>
        </a>
      </li>
    ))}
  </ol>
</Base>
